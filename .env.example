# Copy this file to .env and adjust the values -- the app loads it on startup.
# Variables already set in the real environment always take precedence.

# Database Configuration
DATABASE_URL=sqlite:///./task_manager.db

# API Authentication
# Shared secret required via the X-API-Key header on every /api/* endpoint.
# Generate a strong random value for real deployments, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-generate-a-real-secret

# Rate limiting (write endpoints: POST/PUT/DELETE). See ARCHITECTURE.md.
# Requests over this limit are rejected with 429.
RATE_LIMIT_WRITE=20/minute

# Maximum accepted request body, in bytes (default 100 KB). Anything larger
# is rejected with 413 before the body is parsed. See SECURITY.md.
MAX_BODY_BYTES=102400
